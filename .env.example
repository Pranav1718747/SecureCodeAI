# ==============================================================================
# SECURECODEAI ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# General Configuration
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-me-in-production-securecodeai-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,backend,frontend

# Django Backend Settings
DJANGO_PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
POSTGRES_DB=securecodeai_db
POSTGRES_USER=securecodeai_admin
POSTGRES_PASSWORD=securecodeai_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis & Celery Configuration
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# AI Infrastructure & Cloud Credentials
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
AWS_SAGEMAKER_ENDPOINT=securecodeai-qlora-endpoint
HUGGINGFACE_API_TOKEN=hf_your_huggingface_api_token
S3_BUCKET_NAME=securecodeai-artifacts-bucket

# Frontend Environment Variables
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENABLE_MOCK_DATA=false
