components:
  schemas:
    APIKey:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
          description: Globally unique UUIDv4 identifier for this entity.
        name:
          type: string
          maxLength: 100
        key_prefix:
          type: string
          readOnly: true
        scopes: {}
        expires_at:
          type: string
          format: date-time
          nullable: true
        is_revoked:
          type: boolean
          readOnly: true
        created_at:
          type: string
          format: date-time
          readOnly: true
          description: Immutable timestamp of initial record creation.
      required:
      - created_at
      - id
      - is_revoked
      - key_prefix
      - name
    ActionEnum:
      enum:
      - ACCEPTED
      - REJECTED
      - MODIFIED
      type: string
      description: |-
        * `ACCEPTED` - Accepted
        * `REJECTED` - Rejected
        * `MODIFIED` - Modified
    AstIndexStatusEnum:
      enum:
      - NOT_INDEXED
      - INDEXING
      - INDEXED
      - FAILED
      type: string
      description: |-
        * `NOT_INDEXED` - Not Indexed
        * `INDEXING` - Indexing
        * `INDEXED` - Indexed
        * `FAILED` - Failed
    AuditLog:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
        ip_address:
          type: string
          nullable: true
        action:
          type: string
          maxLength: 100
        resource_type:
          type: string
          maxLength: 100
        resource_id:
          type: string
          maxLength: 255
        payload:
          nullable: true
        created_at:
          type: string
          format: date-time
          readOnly: true
        organization:
          type: string
          format: uuid
          description: Globally unique UUIDv4 identifier for this entity.
        actor:
          type: string
          format: uuid
          description: Globally unique UUIDv4 identifier for this entity.
          nullable: true
      required:
      - action
      - created_at
      - id
      - organization
      - resource_id
      - resource_type
    CustomTokenObtainPair:
      type: object
      properties:
        email:
          type: string
          writeOnly: true
        password:
          type: string
          writeOnly: true
      required:
      - email
      - password
    FeedbackEvent:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
          description: Globally unique UUIDv4 identifier for this entity.
        created_at:
          type: string
          format: date-time
          readOnly: true
          description: Immutable timestamp of initial record creation.
        updated_at:
          type: string
          format: date-time
          readOnly: true
          description: Timestamp of most recent record modification.
        action:
          $ref: '#/components/schemas/ActionEnum'
        user_comments:
          type: string
          nullable: true
        modified_diff:
          type: string
          nullable: true
        patch:
          type: string
          format: uuid
          description: Globally unique UUIDv4 identifier for this entity.
        reviewed_by:
          type: string
          format: uuid
          description: Globally unique UUIDv4 identifier for this entity.
          readOnly: true
          nullable: true
      required:
      - action
      - created_at
      - id
      - patch
      - reviewed_by
      - updated_at
    FineTuningJob:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
          description: Globally unique UUIDv4 identifier for this entity.
        created_at:
          type: string
          format: date-time
          readOnly: true
          description: Immutable timestamp of initial record creation.
        updated_at:
          type: string
          format: date-time
          readOnly: true
          description: Timestamp of most recent record modification.
        sagemaker_job_name:
          type: string
          maxLength: 255
        base_model:
          type: string
          maxLength: 255
        output_adapter_s3_path:
          type: string
          nullable: true
          maxLength: 1024
        status:
          $ref: '#/components/schemas/FineTuningJobStatusEnum'
        training_loss:
          type: number
          format: double
          nullable: true
        epochs:
          type: integer
        learning_rate:
          type: number
          format: double
        started_at:
          type: string
          format: date-time
          nullable: true
        finished_at:
          type: string
          format: date-time
          nullable: true
      required:
      - base_model
      - created_at
      - id
      - sagemaker_job_name
      - updated_at
    FineTuningJobStatusEnum:
      enum:
      - STARTING
      - IN_PROGRESS
      - COMPLETED
      - FAILED
      - STOPPED
      type: string
      description: |-
        * `STARTING` - Starting
        * `IN_PROGRESS` - In Progress
        * `COMPLETED` - Completed
        * `FAILED` - Failed
        * `STOPPED` - Stopped
    ModelEvaluation:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
          description: Globally unique UUIDv4 identifier for this entity.
        created_at:
          type: string
          format: date-time
          readOnly: true
          description: Immutable timestamp of initial record creation.
        updated_at:
          type: string
          format: date-time
          readOnly: true
          description: Timestamp of most recent record modification.
        model_identifier:
          type: string
          maxLength: 255
        benchmark_name:
          type: string
          maxLength: 100
        precision_score:
          type: number
          format: double
        recall_score:
          type: number
          format: double
        pass_at_1_score:
          type: number
          format: double
        false_positive_rate:
          type: number
          format: double
        evaluated_at:
          type: string
          format: date-time
          readOnly: true
        fine_tuning_job:
          type: string
          format: uuid
          description: Globally unique UUIDv4 identifier for this entity.
          nullable: true
      required:
      - benchmark_name
      - created_at
      - evaluated_at
      - id
      - model_identifier
      - updated_at
    Organization:
      type: object
      properties:
        id:
          type: string
          format: uuid
          readOnly: true
          description: Globally unique UUIDv4 identifier for this entity.
        created_at:
          type: string
          format: date-time
          readOnly: true
          description: Immutable timestamp of initial record creation.
        updated_at:
          type: string
          format: date-time
          readOnly: true
          description: Timestamp of most recent record modification.
        name:
          type: string
          maxLength: 255
        slug:
          type: string
          maxLength: 255
          pattern: ^[-a-zA-Z0-9_]+$
        domain:
          type: string
          maxLength: 255
        subscription_plan:
          $ref: '#/components/schemas/SubscriptionPlanEnum'
        max_repositories:
          type: integer
        is_active:
          type: boolean
        sso_enabled:
          type: boolean
        sso_saml_config:
          nullable: true
      required:
      - created_at
      - domain
      - id
      - name
      - slug
      - updated_at
    PaginatedAPIKeyList:
      type: object
      required:
      - count
      - results
      properties:
        count:
          type: integer
          example: 123
        next:
          type: string
          nullable: true
